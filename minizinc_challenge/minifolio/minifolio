#!/usr/bin/env bash
set -euo pipefail

ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output-mode)
      if [[ $# -ge 2 ]]; then
        shift 2
      else
        shift
      fi
      ;;

    --output-mode=*)
      shift
      ;;

    --output-objective)
      if [[ $# -ge 2 ]]; then
        shift 2
      else
        shift
      fi
      ;;

    --output-objective=*)
      shift
      ;;

    --ozn-file)
      if [[ $# -ge 2 ]]; then
        shift 2
      else
        shift
      fi
      ;;

    --ozn-file=*)
      shift
      ;;

    --parallel)
      if [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]]; then
        shift 2
      else
        shift
      fi
      ;;

    --parallel=*)
      shift
      ;;

    -p)
      if [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]]; then
        shift 2
      else
        shift
      fi
      ;;

    -p*)
      shift
      ;;

    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ "${#ARGS[@]}" -lt 1 ]]; then
  echo "Usage: minifolio <MZNfile> [<DZNfile> ...]" >&2
  exit 2
fi

TMPDIR="${TMPDIR:-/tmp}"
WORKDIR="$(mktemp -d "$TMPDIR/minifolio.XXXXXX")"

cleanup() {
  rm -rf "$WORKDIR"
}

trap cleanup EXIT

FZN_FILE="$WORKDIR/model.fzn"
OZN_FILE="$WORKDIR/model.ozn"
SUNNY_ERR="$WORKDIR/sunny.err"

minizinc \
  -c \
  --solver gecode \
  --output-ozn-to-file "$OZN_FILE" \
  -o "$FZN_FILE" \
  "${ARGS[@]}"

rm -f "$FZN_FILE"

if [[ "${MINIFOLIO_DEBUG:-0}" = "1" ]]; then
  printf 'MiniFolio command:' >&2
  printf ' %q' sunny-cp \
    -f \
    --cop-a \
    -P chuffed,gecode,cp-sat-p3,cp-sat-p3-lin \
    --wait-time 10 \
    --restart-time-gecode 10 \
    --restart-time-chuffed 30 \
    --restart-time-cp-sat-p3-lin 30 \
    --restart-time-cp-sat-p3 300 \
    --max-restarts-gecode 1 \
    --max-restarts-chuffed 1 \
    --max-restarts-cp-sat-p3-lin 2 \
    --max-restarts-cp-sat-p3 2 \
    "${ARGS[@]}" >&2
  printf ' | minizinc --ozn-file %q\n' "$OZN_FILE" >&2
fi

set +e

env PYTHONUNBUFFERED=1 sunny-cp \
  -f \
  --cop-a \
  -P chuffed,gecode,cp-sat-p3,cp-sat-p3-lin \
  --wait-time 10 \
  --restart-time-gecode 10 \
  --restart-time-chuffed 30 \
  --restart-time-cp-sat-p3-lin 30 \
  --restart-time-cp-sat-p3 300 \
  --max-restarts-gecode 1 \
  --max-restarts-chuffed 1 \
  --max-restarts-cp-sat-p3-lin 2 \
  --max-restarts-cp-sat-p3 2 \
  "${ARGS[@]}" 2>"$SUNNY_ERR" | solns2out "$OZN_FILE"

PIPE_STATUS=("${PIPESTATUS[@]}")

set -e

SUNNY_STATUS="${PIPE_STATUS[0]}"
OZN_STATUS="${PIPE_STATUS[1]}"

if [[ "$OZN_STATUS" -ne 0 ]]; then
  cat "$SUNNY_ERR" >&2
  exit "$OZN_STATUS"
fi

if [[ "$SUNNY_STATUS" -ne 0 ]]; then
  if grep -q 'BrokenPipeError' "$SUNNY_ERR"; then
    exit 0
  fi

  cat "$SUNNY_ERR" >&2
  exit "$SUNNY_STATUS"
fi

cat "$SUNNY_ERR" >&2
exit 0
