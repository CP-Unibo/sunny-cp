#!/usr/bin/env bash
set -euo pipefail

# MiniZinc Challenge wrapper for MiniFolio.
#
# The new SUNNY-CP interface is:
#   sunny-cp      -> user-facing command, MiniZinc-formatted output by default
#   sunny-cp-fzn  -> low-level command, raw FlatZinc solution stream
#
# Therefore this wrapper must NOT create/pass --ozn-file and must NOT call
# solns2out directly. It simply invokes sunny-cp with the desired portfolio.

ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output-mode)
      if [[ $# -ge 2 ]]; then shift 2; else shift; fi
      ;;

    --output-mode=*)
      shift
      ;;

    --output-objective)
      if [[ $# -ge 2 ]]; then shift 2; else shift; fi
      ;;

    --output-objective=*)
      shift
      ;;

    --ozn-file)
      if [[ $# -ge 2 ]]; then shift 2; else shift; fi
      ;;

    --ozn-file=*)
      shift
      ;;

    --parallel)
      # Consumed from /minizinc/par.mpc.
      # Do not pass MiniZinc-style parallel flags to SUNNY-CP.
      if [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]]; then shift 2; else shift; fi
      ;;

    --parallel=*)
      shift
      ;;

    -p)
      # Also consume MiniZinc-style parallel flag if it appears.
      if [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]]; then shift 2; else shift; fi
      ;;

    -p*)
      shift
      ;;

    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ "${#ARGS[@]}" -lt 1 ]]; then
  echo "Usage: minifolio <MZNfile> [<DZNfile> ...]" >&2
  exit 2
fi

SUNNY_ARGS=(
  -f
  --cop-a
  -P chuffed,gecode,cp-sat-p3,cp-sat-p3-lin
  --wait-time 10
  --restart-time-gecode 10
  --restart-time-chuffed 30
  --restart-time-cp-sat-p3-lin 30
  --restart-time-cp-sat-p3 300
  --max-restarts-gecode 1
  --max-restarts-chuffed 1
  --max-restarts-cp-sat-p3-lin 2
  --max-restarts-cp-sat-p3 2
)

if [[ "${MINIFOLIO_DEBUG:-0}" = "1" ]]; then
  SUNNY_ARGS=(-v "${SUNNY_ARGS[@]}")

  printf 'MiniFolio command:' >&2
  printf ' %q' sunny-cp "${SUNNY_ARGS[@]}" "${ARGS[@]}" >&2
  printf '\n' >&2
fi

# Use exec so Docker sends signals directly to sunny-cp.
exec sunny-cp "${SUNNY_ARGS[@]}" "${ARGS[@]}"
