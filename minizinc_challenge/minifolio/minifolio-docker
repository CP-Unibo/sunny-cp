#!/usr/bin/env bash
set -euo pipefail

IMAGE="${MINIFOLIO_IMAGE:-ramadini/minifolio:2026}"
ENTRYPOINT="${MINIFOLIO_ENTRYPOINT:-/usr/local/bin/minifolio}"

usage() {
  echo "Usage: minifolio-docker <model.mzn> [data.dzn ...]" >&2
  echo "" >&2
  echo "Example:" >&2
  echo "  minifolio-docker cp_model_roberto.mzn data/coffee_table.dzn" >&2
}

if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "Error: docker command not found." >&2
  exit 1
fi

DOCKER=(docker)

# If normal docker access fails, try sudo docker.
if ! docker info >/dev/null 2>&1; then
  if command -v sudo >/dev/null 2>&1; then
    DOCKER=(sudo docker)
  fi
fi

ARGS=()
MOUNTS=()
FIRST_DIR=""

declare -A SEEN_DIRS=()

for arg in "$@"; do
  if [[ ! -e "$arg" ]]; then
    echo "Error: file not found: $arg" >&2
    exit 1
  fi

  abs="$(realpath "$arg")"
  dir="$(dirname "$abs")"

  if [[ -z "$FIRST_DIR" ]]; then
    FIRST_DIR="$dir"
  fi

  if [[ -z "${SEEN_DIRS[$dir]+x}" ]]; then
    MOUNTS+=("-v" "$dir:$dir:rw")
    SEEN_DIRS["$dir"]=1
  fi

  ARGS+=("$abs")
done

RUN_OPTS=(--rm --init)

# Use a TTY only for interactive terminal runs. This makes Ctrl+C nicer
# locally without breaking non-interactive scripts/CI.
if [[ -t 0 && -t 1 ]]; then
  RUN_OPTS+=(-it)
fi

if [[ -n "$ENTRYPOINT" ]]; then
  RUN_OPTS+=(--entrypoint "$ENTRYPOINT")
fi

exec "${DOCKER[@]}" run \
  "${RUN_OPTS[@]}" \
  -e PYTHONUNBUFFERED=1 \
  "${MOUNTS[@]}" \
  -w "$FIRST_DIR" \
  "$IMAGE" \
  "${ARGS[@]}"
