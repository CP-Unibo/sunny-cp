#!/usr/bin/env bash
set -euo pipefail

FZN_CMD="${SUNNY_CP_FZN:-sunny-cp-fzn}"

usage_note() {
  cat <<'EOF'

Output modes:
  sunny-cp
      User-facing command. Prints MiniZinc-formatted output by default.

      Internally runs:
          sunny-cp-fzn --mzn-output ... | solns2out

  sunny-cp --fzn-output ...
      Run the low-level FlatZinc engine directly and print raw FlatZinc
      solution output.

Low-level command:
  sunny-cp-fzn
      Raw FlatZinc-oriented SUNNY-CP engine.

EOF
}

case "${1:-}" in
  -h|--help)
    "$FZN_CMD" --help
    usage_note
    exit 0
    ;;

  --fzn-output)
    shift
    exec "$FZN_CMD" "$@"
    ;;

  --fzn-output-help)
    "$FZN_CMD" --help
    exit 0
    ;;
esac

export PYTHONUNBUFFERED=1

"$FZN_CMD" --mzn-output "$@" | solns2out
