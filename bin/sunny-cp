#! /usr/bin/env python3
'''
sunny-cp executable module.
'''

import errno
import os
import re
import sys
import copy
import time
import fcntl
import psutil
import shutil
import signal
import tempfile
import traceback
import multiprocessing
from subprocess import PIPE, Popen
SUNNY_HOME = os.path.realpath(__file__).split('/')[:-2]
SUNNY_HOME = '/'.join(SUNNY_HOME)
sys.path.append(SUNNY_HOME + '/src')
from pfolio_solvers import *
from scheduling import *
from features import *
from solver import *
from parsing import *
from problem import *

# List of the running solvers.
RUNNING_SOLVERS = []
# List of the suspended solvers.
SUSP_SOLVERS = []
# If KEEP, don't delete temporary files.
KEEP = False
# List of temporary file paths.
TMP_FILES = []
# Sleep time (in seconds) for multiprocessing.
SLEEP_TIME = 0.01
# Bytes read from each solver stdout pipe at a time.
READ_CHUNK_SIZE = 64 * 1024
# Avoid spending an entire loop iteration draining one very chatty solver.
MAX_READ_CHUNKS = 16
# Partial stdout lines, keyed by child process pid.
STDOUT_BUFFERS = {}
# Initial lower bound of the problem to be solved.
LOWER_BOUND = float('-inf')
# Initial lower bound of the problem to be solved.
UPPER_BOUND = float('+inf')
# Initial starting time of the algorithm.
STARTING_TIME = time.time()

def log(*args, file=sys.stderr):
    # TODO: Add -v, --verbose option to avoid logging.
    print(f"% {' '.join([str(x) for x in args])}", file=file)

def handler(signum=None, frame=None):
    """
    Handles termination signals.
    """
    print('Signal handler called with signal', signum, file=sys.stderr)
    clean()
    sys.stdout.close()
    sys.exit(signum)

for sig in [signal.SIGTERM, signal.SIGINT, signal.SIGHUP, signal.SIGQUIT]:
    signal.signal(sig, handler)


def send_signal_solver(signal, solver):
    """
    Sends the specified signal to the solver process, and to all its children.
    """
    proc = solver.process
    if proc.poll() is None:
        for p in proc.children(recursive=True):
            try:
                p.send_signal(signal)
            except psutil.NoSuchProcess:
                pass
        try:
            proc.send_signal(signal)
        except psutil.NoSuchProcess:
            pass


def clean():
    """
    Utility for (possibly) cleaning temporary files and killing the solvers
    processes at the end of the solving process (even when the termination is
    forced externally).
    """
    global RUNNING_SOLVERS, SUSP_SOLVERS
    for solver in RUNNING_SOLVERS + SUSP_SOLVERS:
        send_signal_solver(signal.SIGKILL, solver)
    # Possibly remove temporary files.
    if not KEEP:
        for f in TMP_FILES:
            if os.path.exists(f):
                os.remove(f)


def solve(schedule, problem, cores, mem_limit, all_opt, check, kill_idle=False):
    """
    Runs (possibly in parallel on different cores) the solving phase.
    """

    global RUNNING_SOLVERS, SUSP_SOLVERS
    # Launch the solvers (if any).
    for _ in range(cores):
        if schedule:
            solver = schedule.pop(0)
            run_solver(solver, problem)

    # Loop for dealing with solvers execution.
    while RUNNING_SOLVERS:
        time.sleep(SLEEP_TIME)

        if len(RUNNING_SOLVERS) > 1 and mem_limit < 100:
            mems = dict((s, s.mem_percent()) for s in RUNNING_SOLVERS)
            if sum(mems.values()) > mem_limit:
                solver = max(list(mems.items()), key=lambda x: x[1])[0]
                log('Warning! Exceeded the maximum allowed memory')
                log(f'Killing solver {solver.name}')
                send_signal_solver(signal.SIGKILL, solver)
                RUNNING_SOLVERS.remove(solver)
                continue

        for solver in RUNNING_SOLVERS:
            # Read and process lines from the output stream of each process.
            lines = read_lines(solver.process)
            if lines:
                p = process_output(solver, problem, lines, all_opt, check,
                                   schedule)
                if not p:
                    continue
                    
            # Solver process terminated.
            if solver.process.poll() is not None:
                if solver.status == 'flatzinc':
                    # Sometimes not all the lines are read from solver output.
                    lines = read_lines(solver.process)
                    if lines:
                        p = process_output(solver, problem, lines, all_opt,
                                           check, schedule)
                        if not p:
                            continue
                solver_terminated(solver, problem, schedule)
                continue

            # Expired timeout: the solver is killed.
            if  time.time() - solver.start_time > solver.timeout \
            and time.time() - solver.solution_time > solver.wait_time:
                solver_timeout(solver, problem, schedule)
                continue

            # Restart a solver if its solution is obsolete and its restart time
            # is actually expired.
            if solver.status == 'flatzinc' \
            and problem.bound_better_than(solver.obj_value) \
            and time.time() - solver.solution_time > solver.restart_time:
            
                if kill_idle and solver.num_restarts >= 1 \
                             and not solver.found_solution:
                    log(f'Killing idle solver {solver.name}: ' + \
                        f'no solution after {solver.num_restarts} restart(s)')
                    assert (solver.num_restarts == 1)
                    send_signal_solver(signal.SIGKILL, solver)
                    RUNNING_SOLVERS.remove(solver)
                    if schedule:
                        new_solver = schedule.pop(0)
                        new_solver.timeout += max(solver.timeout - (time.time() - solver.start_time), 0)
                        run_solver(new_solver, problem)
                    continue

            
                if solver.num_restarts < solver.max_restarts:
                    solver.num_restarts += 1
                    send_signal_solver(signal.SIGKILL, solver)
                    RUNNING_SOLVERS.remove(solver)
                    log(f'Restarting {solver.name} after ' + \
                        f'{time.time() - solver.solution_time}s inactivity'+ \
                        f' (restart no. {solver.num_restarts})')
                    solver.timeout = max(
                        solver.timeout - (time.time() - solver.start_time), 0
                    )
                    run_solver(solver, problem)
                    continue
                else:
                    assert(len(RUNNING_SOLVERS) > 1)
                    log(f'{solver.name} reached the maximum number of restarts!')
                    log(f'Killing solver {solver.name}')
                    send_signal_solver(signal.SIGKILL, solver)
                    RUNNING_SOLVERS.remove(solver)
                    n = os.cpu_count()
                    
                    if schedule:
                        new_solver = schedule.pop(0)
                        new_solver.timeout += max(solver.timeout - (time.time() - solver.start_time), 0)
                        run_solver(new_solver, problem)
                        continue
                        
                    if len(RUNNING_SOLVERS) == 1 and solver.n_threads <= n:
                        solver = RUNNING_SOLVERS[0]
                        solv_name = solver.name
                        log(f'{solv_name} only survivor')
                        solv_id = solver.version_id
                        match = re.search(r"^(.*)-p(\d+)$", solv_id)
                        prefix = match.group(1) if match else solv_id
                        n -= solver.n_threads
                        if solver.n_threads == 1:
                            # Last solver is single-threaded.
                            assert (match is None)
                            new_version = f'{solv_id}' + (f'-p{n}' if n > 1 else '')
                            if solver.solver_id == 'cp-sat' and \
                            not solver.version_id.endswith('-lin') \
                            and new_version + '-lin' in ALL_SOLVERS:
                                new_version += '-lin'
                            new_info = ALL_SOLVERS[new_version] \
                                if new_version in ALL_SOLVERS else ALL_SOLVERS[prefix]
                            # FIXME: otherwise run n-1 different copies of solver?
                        else:
                            # Last solver is multi-threaded.
                            assert (match)
                            assert (int(match.group(2)) == solver.n_threads)
                            new_version = f'{prefix}' + (f'-p{n}' if n > 1 else '')
                            if solver.solver_id == 'cp-sat' and \
                            not solver.version_id.endswith('-lin') \
                            and new_version + '-lin' in ALL_SOLVERS:
                                new_version += '-lin'
                            new_info = ALL_SOLVERS[new_version]                        
                        n = ALL_SOLVERS[new_info['version_id']]['replica_id']
                        n += 1
                        if n == 1:
                            new_info['name'] += f' (replica no. {n})'
                        else:
                            new_info['name'] = re.sub(
                                r"\(replica no\. (\d+)\)", lambda m :
                                f"(replica no. {int(m.group(1)) + 1})",
                                new_info['name']
                            )
                        ALL_SOLVERS[new_info['version_id']]['replica_id'] = n
                        new_solv = Solver(new_info, solver.solve, solver.fzn_path, \
                                          solver.all_opt, solver.free_opt, \
                                          solver.wait_time, solver.restart_time, \
                                          solver.timeout, solver.max_restarts,
                                          solver.obj_var)
                        log(f'Adding {new_solv.name}')
                        if new_solv.solver_id == 'cp-sat' and not solver.version_id.endswith('-lin'):
                            tmp_mzn = tempfile.NamedTemporaryFile().name + '.mzn'
                            shutil.copyfile(problem.mzn_path, tmp_mzn)
                            with open(tmp_mzn, 'a') as outfile:
                                i = '<' if problem.solve == 'min' else '>'
                                outfile.write(f'constraint _objective {i} {problem.best_bound};\n')
                            new_solv.obj_var = None
                            problem.mzn_path = tmp_mzn
                                              
                            # FIXME: Experimental support for cp-sat warm start on linearised problem.
#                            ws_vars = ''
#                            ws_vals = ''
#                            for var, val in solver.solution.items():
#                                if 'X_INTRODUCED_' not in var and '%' not in var:
#                                     ws_vars += (var if '[' in val else '[' + var + ']') + ' ++ '
#                                     ws_vals += (val if '[' in val else '[' + val + ']') + ' ++ '
#                            warm_start = f':: warm_start({ws_vars + "[]"}, {ws_vals + "[]"})'
#                            tmp_mzn = tempfile.NamedTemporaryFile().name + '.mzn'
#                            with open(problem.mzn_path, 'r') as infile:
#                                with open(tmp_mzn, 'w') as outfile:
#                                    for line in infile.readlines():
#                                        line = line.strip()
#                                        if not line or line.startswith('%'):
#                                            continue
#                                        tokens = line.replace('::', ' ').replace(';', '').split()
#                                        if 'solve' in tokens:
#                                            line = line.replace('solve', f'solve {warm_start} ')
#                                        outfile.write(f'{line}\n')
#                                    i = '<' if problem.solve == 'min' else '>'
#                                    outfile.write(f'constraint _objective {i}= {problem.best_bound};\n')
#                                    new_solv.obj_value = problem.best_bound                            
#                            problem.mzn_path = tmp_mzn
#                            new_solv.solv_opts += " --params repair_hint:true --params hint_conflict_limit:100000 --params random_seed:42"                            
                            new_solv.status = 'ready'                            
                            log(f'New mzn: {tmp_mzn}')
                        else:
                            new_solv.status = 'flatzinc'
                        run_solver(new_solv, problem)
                        continue

def presolve(
    schedule, problem, cores, mem_limit, all_opt, check, extractor=None,
    k=0, kb=None, lims=None
):
    """
    Runs (possibly in parallel on different cores) the pre-solving phase.
    A part from the (possibly empty) static schedule execution, by properly
    setting the "extractor", "k", "kb", and "lims" this function also allows to
    extract the feature vector and then to compute the k-nearest neighbours of
    the problem (as soon as a free core is available).
    This function returns a triplet (t, n, b) where:
      t  is the time taken by the whole pre-solving phase;
      n  is the (possibly empty) neighborhood of the problem;
      b  is the (possibly empty) black list the solvers that failed during the
         pre-solving phase.
    """

    global RUNNING_SOLVERS, SUSP_SOLVERS
    start_time = time.time()
    black_list = []
    neighbours = []
    neigh_computed = False if extractor else True

    # Launch the solvers (if any).
    for _ in range(cores):
        if schedule:
            solver = schedule.pop(0)
            run_solver(solver, problem)

    # Loop for dealing with solvers execution.
    while RUNNING_SOLVERS or not neigh_computed:
        time.sleep(SLEEP_TIME)

        if not neigh_computed and len(RUNNING_SOLVERS) < cores:
            log('Extracting features...')
            feat_vector = extractor.extract_features([problem, lims])
            if feat_vector:
                neighbours = get_neighbours(feat_vector, k, kb)
                if k <= 0:
                    k = len(neighbours)
                log(f'Computed the {k}-nearest neighbors of the problem')
            else:
                log('Features extraction failed!')
            neigh_computed = True

        if len(RUNNING_SOLVERS) > 1 and mem_limit < 100:
            mems = dict((s, s.mem_percent()) for s in RUNNING_SOLVERS)
            if sum(mems.values()) > mem_limit:
                solver = max(list(mems.items()), key=lambda x: x[1])[0]
                log('Warning! Exceeded the maximum allowed memory')
                log(f'Killing solver {solver.name}')
                send_signal_solver(signal.SIGKILL, solver)
                RUNNING_SOLVERS.remove(solver)
                continue

        for solver in RUNNING_SOLVERS:
            # Read and process lines from the output stream of each process.
            lines = read_lines(solver.process)
            if lines:
                p = process_output(solver, problem, lines, all_opt, check,
                                   schedule)
                if not p:
                    continue

            # Solver process terminated.
            if solver.process.poll() is not None:
                if solver.status == 'flatzinc':
                    # Sometimes not all the lines are read from solver output.
                    lines = read_lines(solver.process)
                    if lines:
                        p = process_output(solver, problem, lines, all_opt,
                                           check, schedule)
                        if not p:
                            continue
                solver_terminated(solver, problem, schedule)
                if solver.process.returncode not in [None, 0]:
                    black_list.append(solver.name)
                continue

            # Expired timeout: the solver has to be suspended.
            if time.time() - solver.start_time > solver.timeout \
            and time.time() - solver.solution_time > solver.wait_time:
                solver_timeout(solver, problem, schedule, kill=False)
                continue

            # Restart a solver if its solution is obsolete and its restart time
            # is actually expired.
            if solver.status == 'flatzinc' \
            and problem.bound_better_than(solver.obj_value) \
            and time.time() - solver.solution_time > solver.restart_time:
                send_signal_solver(signal.SIGKILL, solver)
                RUNNING_SOLVERS.remove(solver)
                log(f'Restarting {solver.name} after ' + \
                    f'{time.time() - solver.solution_time}s inactivity')
                solver.timeout = max(
                    solver.timeout - (time.time() - solver.start_time), 0
                )
                run_solver(solver, problem)
                continue

    return neighbours, time.time() - start_time, black_list


def run_solver(solver, problem):
    """
    Executes a solver according to its status.
    """
    global RUNNING_SOLVERS, SUSP_SOLVERS
    susp = [s for s in SUSP_SOLVERS if s.name == solver.name]
    if susp:
        susp_solver = susp[0]
        SUSP_SOLVERS.remove(susp_solver)
        resume_solver(susp_solver, solver.timeout)
        return
    if solver.status == 'ready':
        log(f'Starting {solver.name} for {solver.timeout} seconds')
        cmd = solver.mzn2fzn_cmd(problem)
        solver.status = 'mzn2fzn'
    elif solver.status == 'mzn2fzn':
        if problem.isCOP() and not solver.obj_var:
            # Extract and set the objective variable from the FlatZinc instance.
            solver.set_obj_var(problem, LOWER_BOUND, UPPER_BOUND)
        cmd = solver.flatzinc_cmd(problem)
        solver.status = 'flatzinc'
    elif solver.status == 'flatzinc':
        if solver.name == problem.best_solver or \
           problem.bound_better_than(solver.obj_value):
            # Starts the solver with a better bound.
            bound = problem.best_bound
            log(f'Injecting value {bound} to {solver.name} FlatZinc instance')
            solver.inject_bound(bound)
        cmd = solver.flatzinc_cmd(problem)

    else:
        log(f'Unknown status {solver.status}')
        assert False
    if solver.status == 'flatzinc':
        solver.process = psutil.Popen(cmd, stdout=PIPE)
        # For non-blocking read.
        fd = solver.process.stdout.fileno()
        fl = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, fl | os.O_NONBLOCK)
    else:
        solver.process = psutil.Popen(cmd)
    solver.start_time = time.time()
    solver.solution_time = time.time()
    RUNNING_SOLVERS.append(solver)


def read_lines(proc):
    """
    Return complete stdout lines currently available from a process.

    FlatZinc solvers are started with stdout=PIPE and the file descriptor is
    set to non-blocking mode.  A non-blocking read can stop in the middle of a
    line, so incomplete lines are buffered until the next call.  When EOF is
    reached, the remaining partial line is flushed.
    """
    if proc.stdout is None:
        return b''

    chunks = []
    pid = proc.pid

    for _ in range(MAX_READ_CHUNKS):
        try:
            chunk = os.read(proc.stdout.fileno(), READ_CHUNK_SIZE)
        except BlockingIOError:
            break
        except InterruptedError:
            continue
        except OSError as exc:
            if exc.errno in {errno.EAGAIN, errno.EWOULDBLOCK}:
                break
            if exc.errno == errno.EBADF:
                tail = STDOUT_BUFFERS.pop(pid, b'')
                return tail + b''.join(chunks)
            STDOUT_BUFFERS.pop(pid, None)
            raise

        if not chunk:
            # EOF: flush any unterminated final line.
            tail = STDOUT_BUFFERS.pop(pid, b'')
            return tail + b''.join(chunks)

        chunks.append(chunk)

    data = STDOUT_BUFFERS.pop(pid, b'') + b''.join(chunks)
    if not data:
        return b''

    last_newline = data.rfind(b'\n')
    if last_newline == -1:
        STDOUT_BUFFERS[pid] = data
        return b''

    complete = data[:last_newline + 1]
    tail = data[last_newline + 1:]
    if tail:
        STDOUT_BUFFERS[pid] = tail
    return complete


def check_solution(solver, problem, solution, bound):
    """
    Uses solver for checking the problem solution
    """
    tmp_mzn = tempfile.NamedTemporaryFile().name + '.mzn'
    with open(problem.mzn_path, 'r') as infile:
        with open(tmp_mzn, 'w') as outfile:
            for (var, val) in solution:
                if 'X_INTRODUCED_' not in var and '%' not in var:
                    outfile.write('constraint ' + var + ' = ' + val + ';\n')
            for row in infile:
                if row:
                    outfile.write(row)
    infile.close()
    outfile.close()

    tmp_fzn = tempfile.NamedTemporaryFile().name + '.fzn'
    cmd = 'minizinc -c --no-output-ozn --solver ' + solver + ' ' + tmp_mzn + \
          ' ' + problem.dzn_path + ' -o ' + tmp_fzn
    proc = Popen(cmd.split(), stdout=PIPE, stderr=PIPE)
    (out, err) = proc.communicate()
    if 'model inconsistency detected' in err or not os.path.exists(tmp_fzn):
        return False

    solv = ALL_SOLVERS[solver]
    inf = float('inf')
    rs = Solver(solv, problem.solve, tmp_fzn, '', inf, inf, inf, False, inf)
    if problem.isCOP():
        rs.set_obj_var(problem, bound, bound)
    cmd = solv.fzn_exec + ' ' + tmp_fzn
    proc = Popen(cmd.split(), stdout=PIPE, stderr=PIPE)
    (out, err) = proc.communicate()
    out = out.decode()
    if '=====UNSATISFIABLE=====' in out or '=====UNBOUNDED=====' in out:
        return False

    return True


def process_output(solver, problem, lines, all_opt, check, schedule):
    """
    Processes the output of a solver.
    """
    if solver.name in list(check.keys()):
        trusted_solver = check[solver.name]
    else:
        trusted_solver = None
    for line in lines.decode().split('\n'):
        
        if line == '----------':
            if problem.isCSP():
                log(solver.name, 'found a solution')
                if trusted_solver:
                    log(f'Checking {solver.name} solution with {trusted_solver}')
                    if check_solution(
                        trusted_solver, problem, list(solver.solution.items()),
                        solver.obj_value
                    ):
                        log('Success!')
                    else:
                        log(f'Failed! Killing solver {solver.name}')
                        send_signal_solver(signal.SIGKILL, solver)
                        solver_terminated(solver, problem, schedule)
                        return
                for (var, val) in list(solver.solution.items()):
                    print(var + ' = ' + val + ';')
                print(line)
                if not all_opt:
                    log(f'Search completed by {solver.name}')
                    log(f'Search completed at time: {time.time() - STARTING_TIME}')
                    clean()
                    sys.exit(0)
            elif problem.bound_worse_than(solver.obj_value):
                # The objective value found is the best so far.
                log(solver.name, 'found a new, better solution')
                if trusted_solver:
                    log(f'Checking {solver.name} solution with {trusted_solver}')
                    if check_solution(
                        trusted_solver, problem, list(solver.solution.items()),
                        solver.obj_value
                    ):
                        log('Success!')
                    else:
                        log(f'Failed! Killing solver {solver.name}')
                        send_signal_solver(signal.SIGKILL, solver)
                        solver_terminated(solver, problem, schedule)
                        return False
                problem.best_bound = solver.obj_value
                log(f'Current Best Bound: {solver.obj_value}')
                log(f'Current Solution Time: {time.time() - STARTING_TIME}')
                if solver.all_opt:
                    for (var, val) in list(solver.solution.items()):
                        if var != solver.obj_var or solver.output_var:
                            print(var + ' = ' + val + ';')
                    print(line)
                    #solver.solution = {}
                problem.best_solver = solver.name
            solver.solution_time = time.time()
            
        elif line == '==========' or line == '=====UNSATISFIABLE=====':
            if trusted_solver:
                if not all_opt and problem.bound_worse_than(solver.obj_value):
                    log(f'Checking {solver.name} solution with {trusted_solver}')
                    if check_solution(
                        trusted_solver, problem, list(solver.solution.items()),
                        solver.obj_value
                    ):
                        log('Success!')
                        for (var, val) in list(solver.solution.items()):
                            if var != solver.obj_var or solver.output_var:
                                print(var + ' = ' + val + ';')
                        print('----------')
                        if problem.isCSP():
                            log(f'Search completed by {solver.name}')
                            log(f'Search completed at time: {time.time() - STARTING_TIME}')
                            clean()
                            sys.exit(0)
                    else:
                        log(f'Failed! Killing solver {solver.name}')
                        send_signal_solver(signal.SIGKILL, solver)
                        solver_terminated(solver, problem, schedule)
                        return False
                return True
            if not problem.has_bound():
                print(line)
            else:
                if not all_opt:
                    for (var, val) in list(solver.solution.items()):
                        if var != solver.obj_var or solver.output_var:
                            print(var + ' = ' + val + ';')
                    print('----------')
                print('==========')
            log(f'Search completed by {solver.name}')
            log(f'Search completed at time: {time.time() - STARTING_TIME}')
            clean()
            sys.exit(0)
        elif ' = ' in line:
            solver.found_solution = True
            idx = line.index(' = ')
            val = line[idx + 3:].split(';')[0]
            var = line[:idx]
            if val and var == solver.obj_var:
                solver.obj_value = int(val)
                if problem.bound_better_than(solver.obj_value):
#                    log(f'{solver.name} found sub-optimal solution with ' +
#                      f'objective bound {solver.obj_value}')
                    solver.solution_time = time.time()
                    solver.solution = {}
                    return True
            solver.solution[var] = val
            solver.solution_time = time.time()
    return True


def solver_terminated(solver, problem, schedule):
    """
    Handles the termination of a solver, possibly launching a new solver.
    """
    global RUNNING_SOLVERS, SUSP_SOLVERS
    if solver in RUNNING_SOLVERS:
        RUNNING_SOLVERS.remove(solver)
    if solver.status == 'mzn2fzn':
        if solver.process.returncode == 0:
            log(f'MiniZinc model converted by {solver.name}.')
            timeout = max(solver.timeout - time.time() + solver.start_time, 0)
            log(f'Starting the FlatZinc execution for {str(timeout)} seconds')
            solver.timeout = timeout
            run_solver(solver, problem)
        else:
            log(f'Error! MiniZinc model not converted by {solver.name}')
            del ALL_SOLVERS[solver.version_id]
            log(f'% Removing solver {solver.name}')
            if solver.version_id.endswith('-lin'):
                bad_solvers = [
                    s for (s, item) in ALL_SOLVERS.items() if s.endswith('-lin') \
                    and item['solver_id'] == solver.solver_id
                ]
                for s in bad_solvers:
                    log(f'% Removing also solver {s}')
                    del ALL_SOLVERS[s]

            # Launch a new solver if any.
            for s in schedule + SUSP_SOLVERS:
                if s.name == solver.name:
                    schedule.remove(s)
                    if s.status != 'ready':
                        send_signal_solver(signal.SIGKILL, solver)
            if schedule:
                new_solver = schedule.pop(0)
                new_solver.timeout += solver.timeout + solver.start_time \
                    - time.time()
                run_solver(new_solver, problem)
            elif SUSP_SOLVERS:
                new_solver = SUSP_SOLVERS.pop(0)
                new_timeout = new_solver.timeout + solver.timeout + \
                    solver.start_time - time.time()
                resume_solver(new_solver, new_timeout)
    else:
        if solver.process.returncode not in [None, 0]:
            # Premature termination of solver execution.
            log(f'Solver {solver.name} failed prematurely')
            for s in schedule + SUSP_SOLVERS:
                if s.name == solver.name:
                    schedule.remove(s)
                    if s.status != 'ready':
                        send_signal_solver(signal.SIGKILL, solver)
        # Launch a new solver if any.
        if schedule:
            new_solver = schedule.pop(0)
            new_solver.timeout += \
                solver.timeout + solver.start_time - time.time()
            run_solver(new_solver, problem)
        elif SUSP_SOLVERS:
            new_solver = SUSP_SOLVERS.pop(0)
            new_timeout = new_solver.timeout + solver.timeout + \
                solver.start_time - time.time()
            resume_solver(new_solver, new_timeout)


def solver_timeout(solver, problem, schedule, kill=True):
    """
    Handles the timeout of a solver process, possibly launching a new solver.
    """
    global RUNNING_SOLVERS, SUSP_SOLVERS
    log(f'Timeout expired for {solver.name}')
    if schedule:
        new_solver = schedule.pop(0)
        if new_solver.timeout == 0:
            # In this case, all the scheduled solvers have been run (or are
            # running on another core). This happens at time t >= T, where T is
            # the timeout T of the SUNNY algorithm.
            if len(RUNNING_SOLVERS) == 1:
                log(f'{solver.name} not interrupted: it is the only running solver')
                solver.timeout = float("+inf")
            elif solver.name == problem.best_solver:
                log(f'{solver.name} not interrupted: it is the best one so far')
                solver.timeout = float("+inf")
            else:
                send_signal_solver(signal.SIGKILL, solver)
                RUNNING_SOLVERS.remove(solver)
                susp = [
                    s for s in SUSP_SOLVERS if s.name == problem.best_solver
                ]
                if susp:
                    # Resuming the best solver so far, it it was suspended.
                    resume_solver(susp[0], float("+inf"))
                # The schedule is no more needed.
                schedule = []
                for solver in SUSP_SOLVERS:
                    send_signal_solver(signal.SIGKILL, solver)
                SUSP_SOLVERS = []
        else:
            if new_solver.name != solver.name:
                if kill:
                    send_signal_solver(signal.SIGKILL, solver)
                    RUNNING_SOLVERS.remove(solver)
                else:
                    suspend_solver(solver)
                run_solver(new_solver, problem)
            else:
                log(f'Solver {solver.name} not interrupted: it has to run again.')
    elif kill:
        send_signal_solver(signal.SIGKILL, solver)
        RUNNING_SOLVERS.remove(solver)
    else:
        suspend_solver(solver)


def suspend_solver(solver):
    """
    Suspends a solver that reached its timeout.
    """
    global RUNNING_SOLVERS, SUSP_SOLVERS
    log(f'Suspending solver {solver.name}')
    send_signal_solver(signal.SIGSTOP, solver)
    SUSP_SOLVERS.append(solver)
    RUNNING_SOLVERS.remove(solver)


def resume_solver(solver, timeout):
    """
    Resumes a solver, and run it for timeout seconds.
    """
    global RUNNING_SOLVERS
    log(f'Resuming solver {solver.name} for {timeout} seconds')
    solver.timeout = timeout
    send_signal_solver(signal.SIGCONT, solver)
    solver.start_time = time.time()
    solver.solution_time = time.time()
    RUNNING_SOLVERS.append(solver)


def init_schedule(schedule, options, solve, tmp_id, all_opt, free_opt):
    """
    Initializes a schedule, making it ready to be executed.
    """
    global TMP_FILES
    running_schedule = []
    ao = '-a' if all_opt else ''
    fo = '-f' if free_opt else ''
    for (s, t) in schedule:
        solver_info = ALL_SOLVERS[s] 
        fzn_path = tmp_id + '.' + s + '.fzn'        
        wt = options[s]['wait_time']
        rt = options[s]['restart_time']
        mr = options[s]['max_restarts']
        solver = Solver(solver_info, solve, fzn_path, ao, fo, wt, rt, t, mr)
        running_schedule.append(solver)
        TMP_FILES.append(fzn_path)
    return running_schedule


def main(args):
    global KEEP, TMP_FILES, LOWER_BOUND, UPPER_BOUND
    try:
        # Input arguments parsing and initialization.
        problem, k, timeout, pfolio, backup, kb, lims, static, extractor, \
            cores, solver_options, tmp_id, mem_limit, KEEP, all_opt, free_opt, \
            LOWER_BOUND, UPPER_BOUND, check, kill_idle = parse_arguments(args)
        TMP_FILES = [problem.ozn_path]
        static = init_schedule(
            static, solver_options, problem.solve, tmp_id, all_opt, free_opt
        )

        log('%%%%% Pre-solving %%%%%')
        if cores >= len(pfolio):
            # If the number of specified cores exceeds the portfolio size, then
            # no prediction is needed.
            log('Features extraction not needed!')
            extractor = None
            lims = None
        elif extractor == 'mzn2feat':
            extractor = mzn2feat
        else:
            log('Unknown extractor!')
            extractor = None
            lims = None

        neighbours, static_time, black_list = presolve(
            static, problem, cores, mem_limit, all_opt, check, extractor, k,
            kb, lims
        )

        log('%%%%% Solving %%%%%')
        pfolio = [s for s in pfolio if s not in black_list]
        if not neighbours or len(pfolio) <= cores:
            if len(pfolio) <= cores:
                log('Portfolio size <= No. of cores: no prediction needed!')
            log('Switching to backup solver(s)')
            par_sched = [(s, float('+inf')) for s in pfolio[:cores]]
        else:
            log('Computing solvers schedule...')
            timeout -= round(static_time)
            if backup not in pfolio:
                backup = pfolio[0]
            if k <= 0:
                k = len(neighbours)
            if problem.isCSP():
                seq_sched = sunny_csp(
                    neighbours, k, timeout, pfolio, backup, cores
                )
            else:
                seq_sched = sunny_cop(
                    neighbours, k, timeout, pfolio, backup, cores
                )
            log(f'SUNNY sequential schedule: {seq_sched}')
            if len(seq_sched) <= cores:
                log('Schedule size <= No. of cores! No re-scheduling needed!')
                par_sched = [
                    (s, float('+inf')) for (s, t) in
                    sorted(seq_sched, key=lambda x: x[0], reverse=True)
                ]
                not_sched = [
                    (s, float('+inf')) for s in pfolio
                    if s not in list(dict(par_sched).keys())
                ]
                par_sched += not_sched[:cores - len(seq_sched)]
            else:
                log(f'Parallelizing schedule on {cores} cores')
                par_sched = parallelize(seq_sched, cores, timeout)
        par_sched += [
            (s, 0) for s in pfolio if s not in list(dict(par_sched).keys())
        ]
        log(f'SUNNY parallel schedule: {par_sched}')
        schedule = init_schedule(
            par_sched, solver_options, problem.solve, tmp_id, all_opt, free_opt
        )
        solve(schedule, problem, cores, mem_limit, all_opt, check, kill_idle)

    except Exception as e:
        log('Unexpected Termination of sunny-cp.', file=sys.stderr)
        clean()
        traceback.print_exc()
        sys.exit(1)

    clean()


if __name__ == '__main__':
    main(sys.argv[1:])
