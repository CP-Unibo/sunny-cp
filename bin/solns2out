#!/usr/bin/env python3
import os
import shutil
import subprocess
import sys
import time


OZN_MARKER = "%%%SOLNS2OUT-OZN-FILE "
REMOVE_OZN_MARKER = "%%%SOLNS2OUT-REMOVE-OZN-FILE "


def usage():
    print("Usage: solns2out", file=sys.stderr)
    print("", file=sys.stderr)
    print("Reads a FlatZinc solution stream from stdin.", file=sys.stderr)
    print("OZN files are selected using marker lines of the form:", file=sys.stderr)
    print("", file=sys.stderr)
    print("    %%%SOLNS2OUT-OZN-FILE <file.ozn>", file=sys.stderr)
    print("", file=sys.stderr)
    print("OZN files can be removed at the end using marker lines:", file=sys.stderr)
    print("", file=sys.stderr)
    print("    %%%SOLNS2OUT-REMOVE-OZN-FILE <file.ozn>", file=sys.stderr)


def wait_for_ozn(path):
    wait_seconds = float(os.environ.get("OZN_WAIT_SECONDS", "30"))
    poll_interval = float(os.environ.get("OZN_POLL_INTERVAL", "0.001"))

    deadline = time.monotonic() + wait_seconds

    while time.monotonic() < deadline:
        try:
            if os.path.getsize(path) > 0:
                return True
        except OSError:
            pass

        time.sleep(poll_interval)

    return False


def minizinc_cmd(ozn_file):
    cmd = ["minizinc", "--ozn-file", ozn_file]

    if shutil.which("stdbuf") is not None:
        return ["stdbuf", "-o0", "-e0"] + cmd

    return cmd


class OznConverter:
    def __init__(self, ozn_file):
        self.ozn_file = ozn_file
        self.closed = False

        if not wait_for_ozn(ozn_file):
            raise RuntimeError(f"timed out waiting for OZN file: {ozn_file}")

        self.proc = subprocess.Popen(
            minizinc_cmd(ozn_file),
            stdin=subprocess.PIPE,
            stdout=sys.stdout,
            stderr=sys.stderr,
            text=True,
            bufsize=1,
        )

    def write(self, line):
        if self.closed:
            return

        try:
            self.proc.stdin.write(line)
            self.proc.stdin.flush()
        except BrokenPipeError:
            self.closed = True

    def close(self):
        if self.closed:
            return self.proc.wait()

        try:
            self.proc.stdin.close()
        except BrokenPipeError:
            pass

        self.closed = True
        return self.proc.wait()

    def alive(self):
        return not self.closed and self.proc.poll() is None


def safe_remove_ozn_files(paths):
    if os.environ.get("SOLNS2OUT_KEEP_OZN", "0") == "1":
        return

    for path in sorted(paths):
        # Safety guard: solns2out should only remove .ozn files.
        if not path.endswith(".ozn"):
            print(
                f"Warning: refusing to remove non-.ozn file: {path}",
                file=sys.stderr,
                flush=True,
            )
            continue

        try:
            os.remove(path)
        except FileNotFoundError:
            pass
        except OSError as e:
            print(
                f"Warning: could not remove OZN file {path}: {e}",
                file=sys.stderr,
                flush=True,
            )


def main():
    if len(sys.argv) != 1:
        usage()
        return 2

    current_ozn = None
    converter = None
    exit_status = 0

    used_ozn_files = set()
    remove_ozn_files = set()

    try:
        for line in sys.stdin:
            if line.startswith(OZN_MARKER):
                new_ozn = line[len(OZN_MARKER):].strip()

                if new_ozn == "":
                    print("Error: empty OZN marker", file=sys.stderr, flush=True)
                    exit_status = 1
                    continue

                used_ozn_files.add(new_ozn)

                if converter is not None and new_ozn != current_ozn:
                    status = converter.close()
                    if status != 0:
                        exit_status = status
                    converter = None

                current_ozn = new_ozn

                if converter is None or not converter.alive():
                    try:
                        converter = OznConverter(current_ozn)
                    except RuntimeError as e:
                        print(f"Error: {e}", file=sys.stderr, flush=True)
                        converter = None
                        exit_status = 1

                continue

            if line.startswith(REMOVE_OZN_MARKER):
                path = line[len(REMOVE_OZN_MARKER):].strip()

                if path == "":
                    print("Error: empty REMOVE-OZN marker", file=sys.stderr, flush=True)
                    exit_status = 1
                    continue

                remove_ozn_files.add(path)
                continue

            stripped = line.strip()

            if current_ozn is None or converter is None:
                print(line, end="", flush=True)
                continue

            if stripped.startswith("%"):
                print(line, end="", flush=True)
                continue

            converter.write(line)

            if stripped == "==========":
                status = converter.close()
                if status != 0:
                    exit_status = status
                converter = None

    finally:
        if converter is not None:
            status = converter.close()
            if status != 0:
                exit_status = status

        # Remove both:
        #   1. files explicitly requested by SUNNY-CP,
        #   2. files actually used by solns2out.
        #
        # The explicit remove marker is useful for .ozn files generated by
        # solvers that never produced a solution.
        safe_remove_ozn_files(used_ozn_files | remove_ozn_files)

    return exit_status


if __name__ == "__main__":
    sys.exit(main())
